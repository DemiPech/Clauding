{
  "name": "game-tests",
  "private": true,
  "type": "module",
  "description": "Tests du squelette de jeu : unitaires (moteur, logique) et de bout en bout (jeu dans Chromium).",
  "scripts": {
    "test": "node --test --test-concurrency=4 \"unit/*.test.mjs\" \"e2e/*.test.mjs\"",
    "test:unit": "node --test \"unit/*.test.mjs\"",
    "test:e2e": "node --test \"e2e/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
